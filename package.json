{
	"name": "directus-extension-flow-manager",
	"description": "This is a custom module for managing Flow",
	"icon": "extension",
	"version": "1.5.4",
	"author": {
		"name": "Bagus Andreanto",
		"email": "andreanto.bagus@gmail.com"
	},
	"homepage": "https://github.com/baguse/directus-extension-flow-manager",
	"license": "gpl-3.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"directus-extension-flow-manager",
		"flow-manager",
		"flow",
		"directus-flow"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/baguse/directus-extension-flow-manager.git"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "flow-manager-directus-flow-hook",
				"source": "src/flow-manager-directus-flow-hook/index.ts"
			},
			{
				"type": "endpoint",
				"name": "flow-manager-endpoint",
				"source": "src/flow-manager-endpoint/index.ts"
			},
			{
				"type": "module",
				"name": "flow-manager-module",
				"source": "src/flow-manager-module/index.ts"
			}
		],
		"sandbox": {
			"enabled": true,
			"requestedScopes": {}
		},
		"host": "^10.10.0",
		"icon": "bolt"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"devDependencies": {
		"@directus/composables": "^11.6.2",
		"@directus/extensions-sdk": "^18.0.4",
		"@directus/format-title": "^13.0.0",
		"@types/lodash": "^4.17.25",
		"@types/node": "^20.12.8",
		"chart.js": "^4.5.1",
		"lodash": "^4.18.1",
		"sass": "^1.76.0",
		"secure-ls": "^2.0.0",
		"typescript": "^5.4.5",
		"vue": "^3.4.26",
		"vuedraggable": "^4.1.0"
	}
}
